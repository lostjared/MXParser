file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/native imports.ls-h" "__import__ int module_add(int left, int right);\n__import__ int module_count();\n")
file(WRITE "${OUTPUT_DIR}/session.txt" ":import \"${MODULE}\" \"${OUTPUT_DIR}/native imports.ls-h\"\nmodule_add(20,22)\nmodule_count()\n:import\n:import \"${MODULE}.missing\" \"${OUTPUT_DIR}/native imports.ls-h\"\nmodule_add(1,2)\n:reset\nmodule_add(1,2)\n:quit\n")
execute_process(COMMAND "${PARSER}" --repl INPUT_FILE "${OUTPUT_DIR}/session.txt"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "42\n0\n3\n" OR NOT errors MATCHES "usage: :import" OR NOT errors MATCHES "cannot load module" OR NOT errors MATCHES "Undeclared")
    message(FATAL_ERROR "REPL module import failed: ${status}\n${output}\n${errors}")
endif()
file(WRITE "${OUTPUT_DIR}/program.c" "int main(void){return module_add(20,22);}\n")
foreach(args IN ITEMS "--print-result;--module;${MODULE};--imports;${OUTPUT_DIR}/native imports.ls-h" "-p;-m;${MODULE};-H;${OUTPUT_DIR}/native imports.ls-h")
    execute_process(COMMAND "${PARSER}" ${args} "${OUTPUT_DIR}/program.c"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    string(REPLACE "\r\n" "\n" output "${output}")
    if(NOT status EQUAL 0 OR NOT output STREQUAL "Result: 42\n" OR NOT errors STREQUAL "")
        message(FATAL_ERROR "Program module import failed: ${status}\n${output}\n${errors}")
    endif()
endforeach()
file(WRITE "${OUTPUT_DIR}/preload.txt" "main()\n:quit\n")
execute_process(COMMAND "${PARSER}" --repl --module "${MODULE}" --imports "${OUTPUT_DIR}/native imports.ls-h" "${OUTPUT_DIR}/program.c"
    INPUT_FILE "${OUTPUT_DIR}/preload.txt" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "42\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "Preloaded REPL module import failed: ${status}\n${output}\n${errors}")
endif()
