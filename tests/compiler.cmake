if(NOT DEFINED COMPILER OR NOT DEFINED PARSER OR NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Expected COMPILER, PARSER, SOURCE_DIR, OUTPUT_DIR")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(STRINGS "${SOURCE_DIR}/tests/subset/manifest.tsv" rows)
set(sources)
foreach(row IN LISTS rows)
    if(row MATCHES "^[^#].*\taccept\t-$")
        string(REPLACE "\t" ";" fields "${row}")
        list(GET fields 0 path)
        list(APPEND sources "${SOURCE_DIR}/tests/subset/${path}")
    endif()
endforeach()
list(APPEND sources "${SOURCE_DIR}/examples/subset.c")
set(count 0)
foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME_WE)
    execute_process(COMMAND "${COMPILER}" -std=c99 -pedantic-errors -fsyntax-only "${source}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "C99 compiler rejected original ${source}:\n${output}${errors}")
    endif()
    execute_process(COMMAND "${PARSER}" --check-program "${source}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors WORKING_DIRECTORY "${OUTPUT_DIR}")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Subset validator rejected ${source}:\n${output}${errors}")
    endif()
    set(printed "${OUTPUT_DIR}/${name}.c")
    execute_process(COMMAND "${PARSER}" --syntax-program "${source}"
        RESULT_VARIABLE status OUTPUT_FILE "${printed}" ERROR_VARIABLE errors WORKING_DIRECTORY "${OUTPUT_DIR}")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Could not print ${source}:\n${errors}")
    endif()
    execute_process(COMMAND "${COMPILER}" -std=c99 -pedantic-errors -fsyntax-only "${printed}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "C99 compiler rejected printed ${source}:\n${output}${errors}")
    endif()
    math(EXPR count "${count} + 1")
endforeach()
if(count LESS 16)
    message(FATAL_ERROR "Expected at least 16 supported programs, found ${count}")
endif()
message(STATUS "${count} original and printed translation units passed C99 syntax checks; no C code executed")
