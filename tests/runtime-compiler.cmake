file(MAKE_DIRECTORY "${OUTPUT_DIR}")
execute_process(COMMAND "${TESTER}" --export "${OUTPUT_DIR}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not export execution cases")
endif()
file(READ "${SOURCE_DIR}/examples/subset.c" combined)
file(WRITE "${OUTPUT_DIR}/combined.c" "${combined}")
file(STRINGS "${OUTPUT_DIR}/manifest.tsv" rows)
list(APPEND rows "combined.c\t2")
file(WRITE "${OUTPUT_DIR}/driver.c" "#include <stdio.h>\n#include <limits.h>\ntypedef char require_lp64[(sizeof(long)==8 && sizeof(void*)==8 && CHAR_BIT==8)?1:-1];\nextern int mx_entry(void);\nint main(void){printf(\"%d\\n\",mx_entry());return 0;}\n")
set(count 0)
foreach(row IN LISTS rows)
    string(REPLACE "\t" ";" fields "${row}")
    list(GET fields 0 name)
    list(GET fields 1 expected)
    set(source "${OUTPUT_DIR}/${name}")
    execute_process(COMMAND "${COMPILER}" -std=c99 -pedantic-errors -Dmain=mx_entry -c "${source}" -o "${OUTPUT_DIR}/case.o"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "C compilation failed for ${name}:\n${output}${errors}")
    endif()
    execute_process(COMMAND "${COMPILER}" -std=c99 "${OUTPUT_DIR}/driver.c" "${OUTPUT_DIR}/case.o" -o "${OUTPUT_DIR}/case-native"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "C linkage failed for ${name}:\n${output}${errors}")
    endif()
    execute_process(COMMAND "${OUTPUT_DIR}/case-native" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    string(STRIP "${output}" native)
    if(NOT status EQUAL 0 OR NOT native STREQUAL expected)
        message(FATAL_ERROR "Native ${name} returned '${native}', expected '${expected}': ${errors}")
    endif()
    execute_process(COMMAND "${PARSER}" --print-result "${source}" WORKING_DIRECTORY "${OUTPUT_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    string(STRIP "${output}" interpreted)
    if(NOT status EQUAL 0 OR NOT interpreted STREQUAL "Result: ${native}")
        message(FATAL_ERROR "Interpreter/native mismatch for ${name}: ${interpreted} / ${native}\n${errors}")
    endif()
    math(EXPR count "${count} + 1")
endforeach()
message(STATUS "${count} programs match compiled LP64 C99 execution")
