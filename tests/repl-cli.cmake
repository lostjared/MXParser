file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/session.txt" "1+2\nint x=4\nx+=2\nint twice(int n) {\nreturn n*2;\n}\ntwice(x)\nx=7;\nx\nlsprintf(\"hello %d\\n\",x);\n:quit\n")
execute_process(COMMAND "${PARSER}" --repl INPUT_FILE "${OUTPUT_DIR}/session.txt" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "3\n6\n12\n7\nhello 7\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "REPL transcript failed: ${status}\n${output}\n${errors}")
endif()
file(WRITE "${OUTPUT_DIR}/statements.txt" "int x=0\nif(1) {\nx=2;\n} else {\nx=99;\n}\nwhile(x<4) ++x;\nfor(int i=0;i<3;++i) {\nx+=i;\n}\nswitch(x) {\ncase 7: lsprintf(\"seven\\n\"); break;\ndefault: x=0;\n}\nx\n{ int x=100; x++; }\nx\nx=1; x+=2;\nx\n:quit\n")
execute_process(COMMAND "${PARSER}" --repl INPUT_FILE "${OUTPUT_DIR}/statements.txt" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "seven\n7\n7\n3\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "REPL statements failed: ${status}\n${output}\n${errors}")
endif()
file(WRITE "${OUTPUT_DIR}/recover.txt" "int x=2\n1/0\nx\n:reset\nx\nint x=3\nx\n:quit\n")
execute_process(COMMAND "${PARSER}" INPUT_FILE "${OUTPUT_DIR}/recover.txt" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "2\n3\n" OR NOT errors MATCHES "division by zero" OR NOT errors MATCHES "Undeclared")
    message(FATAL_ERROR "REPL recovery/default mode failed: ${status}\n${output}\n${errors}")
endif()
file(WRITE "${OUTPUT_DIR}/cancel.txt" "int f(void){\n:cancel\n(\n1+2\n)\n/* {\ncomment */\n4+5;\n:quit\n")
execute_process(COMMAND "${PARSER}" --repl INPUT_FILE "${OUTPUT_DIR}/cancel.txt" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "3\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "REPL continuation/cancel failed: ${status}\n${output}\n${errors}")
endif()
file(WRITE "${OUTPUT_DIR}/preload.c" "int n=0; int bump(void){return ++n;} int main(void){n=999;return n;}\n")
file(WRITE "${OUTPUT_DIR}/preload.txt" "n\nbump()\nn\nexit()\n")
execute_process(COMMAND "${PARSER}" --repl "${OUTPUT_DIR}/preload.c" INPUT_FILE "${OUTPUT_DIR}/preload.txt" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "0\n1\n1\n" OR NOT errors STREQUAL "")
    message(FATAL_ERROR "REPL preload unexpectedly ran main or lost state: ${status}\n${output}\n${errors}")
endif()
file(WRITE "${OUTPUT_DIR}/incomplete.txt" "int f(void){\n")
execute_process(COMMAND "${PARSER}" --repl INPUT_FILE "${OUTPUT_DIR}/incomplete.txt" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(status EQUAL 0 OR NOT errors MATCHES "incomplete input")
    message(FATAL_ERROR "REPL incomplete EOF was not reported")
endif()
message(STATUS "REPL transcripts, persistence, preload, error recovery, multiline input, cancellation, reset, and EOF verified")
